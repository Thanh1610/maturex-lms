# -----------------------------------------------------------------------------
# MatureX Client App - Environment Configuration Template
# -----------------------------------------------------------------------------

# Next.js Server & Application Host
PORT=3000
WEB_PORT=3000
APP_HOST=localhost
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]-pooler.[region].aws.neon.tech/[dbname]?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://[user]:[password]@[neon-hostname].[region].aws.neon.tech/[dbname]?channel_binding=require&sslmode=require"
NEON_BRANCH=production

# Authentication & Security (JWT)
JWT_SECRET="generate-a-strong-32-byte-hex-secret-with-crypto-randomBytes"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Client-Side Public Variables
NEXT_PUBLIC_APP_NAME="MatureX LMS"
