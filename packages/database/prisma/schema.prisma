// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  instructor
  learner
}

enum CourseStatus {
  draft
  published
  archived
}

enum AssignmentStatus {
  todo
  submitted
  revision
  approved
}

model User {
  id           String         @id @default(uuid())
  name         String         @db.VarChar(100)
  email        String         @unique @db.VarChar(254)
  role         Role           @default(learner)
  passwordHash String         @map("password_hash") @db.Text
  active       Boolean        @default(true)
  team         String         @default("") @db.VarChar(100)
  job          String         @default("") @db.VarChar(100)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Self-relation: Manager / Subordinates hierarchy
  managerId    String?        @map("manager_id")
  manager      User?          @relation("TeamHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates User[]         @relation("TeamHierarchy")

  // JWT Refresh Tokens
  refreshTokens RefreshToken[]

  // LMS Relations
  ownedCourses   Course[]         @relation("CourseOwner")
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  assignments    Assignment[]
  skills         UserSkill[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Course {
  id          String       @id @default(uuid())
  ownerId     String       @map("owner_id")
  owner       User         @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title       String       @db.VarChar(180)
  description String       @db.Text
  category    String       @db.VarChar(100)
  teacherName String       @default("MatureX") @map("teacher_name") @db.VarChar(100)
  duration    String       @default("2 giờ") @db.VarChar(50)
  level       String       @default("Nền tảng") @db.VarChar(50)
  color       String       @default("lavender") @db.VarChar(50)
  icon        String       @default("Sparkles") @db.VarChar(50)
  label       String       @default("") @db.VarChar(100)
  skill       String       @default("") @db.VarChar(100)
  exercise    String       @default("") @db.Text
  status      CourseStatus @default(published)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  lessons     Lesson[]
  enrollments Enrollment[]
  assignments Assignment[]

  @@index([ownerId])
  @@map("courses")
}

model Lesson {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position  Int
  title     String   @db.VarChar(180)
  content   String   @default("") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  progress  LessonProgress[]

  @@unique([courseId, position])
  @@index([courseId])
  @@map("lessons")
}

model Enrollment {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String   @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String   @map("lesson_id")
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now()) @map("completed_at")

  @@id([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Assignment {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String           @map("course_id")
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String           @db.VarChar(200)
  description String           @default("") @db.Text
  type        String           @default("Sản phẩm thực hành") @db.VarChar(100)
  skill       String           @default("") @db.VarChar(100)
  due         String           @default("") @db.VarChar(50)
  status      AssignmentStatus @default(todo)
  body        String           @default("") @db.Text
  feedback    String           @default("") @db.Text
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@index([courseId])
  @@map("assignments")
}

model UserSkill {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillKey  String   @map("skill_key") @db.VarChar(50)
  name      String   @db.VarChar(100)
  group     String   @db.VarChar(100)
  level     Int      @default(0)
  target    Int      @default(3)
  color     String   @default("lavender") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, skillKey])
  @@index([userId])
  @@map("user_skills")
}
