# -----------------------------------------------------------------------------
# MatureX LMS - Environment Configuration
# -----------------------------------------------------------------------------

# Application Host & Ports
# Next.js defaults to port 3000
WEB_PORT=3000
API_PORT=3001
APP_HOST=localhost
APP_ORIGIN=http://localhost:3000

# Setup & Permissions
LMS_ALLOW_SETUP=1

# Database Configuration (Neon Serverless PostgreSQL via Prisma)
# Pooled connection string (recommended for Next.js serverless/API routes):
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# Direct connection string (optional, used if running migrations needing non-pooled connection):
# DIRECT_URL="postgresql://[user]:[password]@[neon-hostname].[region].aws.neon.tech/[dbname]?sslmode=require"

# Legacy Local SQLite Database (fallback if running without PostgreSQL):
# LMS_DATABASE=.local/lms.sqlite
# LMS_UPLOADS=.local/uploads

# Optional AI Services (docs/INTEGRATIONS.md)
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Enterprise SSO / OIDC
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL="SSO doanh nghiệp"

# Email Notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM="MatureX LMS <no-reply@maturex.io>"
SMTP_USER=
SMTP_PASS=
