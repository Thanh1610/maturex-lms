# Local development. npm run dev / npm start load .env automatically.
# For Docker use .env.production.example instead.
WEB_PORT=5173
API_PORT=3001
APP_HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
LMS_ALLOW_SETUP=1
# Set APP_ORIGIN=http://127.0.0.1:3001 for npm start.
# Prefer data paths outside cloud-sync directories.
# LMS_DATABASE=C:/Users/htvgi/AppData/Local/MatureX/data/lms.sqlite
# LMS_UPLOADS=C:/Users/htvgi/AppData/Local/MatureX/data/uploads

# Optional services: docs/INTEGRATIONS.md. Never commit real values.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=SSO doanh nghiệp
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
